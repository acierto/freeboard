{
  "name": "freeboard",
  "private": true,
  "version": "1.7.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:visual": "vite build --mode visual",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "verify:visual": "node scripts/visual/sync-styles.mjs --check && vite build && vite build --mode visual && node scripts/visual/verify.mjs",
    "verify:visual:baseline": "vite build --mode visual && node scripts/visual/baseline.mjs",
    "verify:visual:selftest": "npm run build:visual && node scripts/visual/selftest.mjs",
    "verify:a11y": "vite build --mode visual && node scripts/a11y/check.mjs",
    "verify:styles": "node scripts/visual/sync-styles.mjs --check",
    "test:ui": "node --test 'tests/ui/*.test.ts'",
    "verify:i18n": "node scripts/i18n/extract-backend.mjs --check && node scripts/i18n/check.mjs",
    "verify:ui": "vite build --mode visual && node scripts/ui/check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
