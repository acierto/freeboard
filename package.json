{
  "name": "freeboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:visual": "vite build --mode visual",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "verify:visual": "vite build && vite build --mode visual && node scripts/visual/verify.mjs",
    "verify:visual:baseline": "vite build --mode visual && node scripts/visual/baseline.mjs",
    "verify:visual:selftest": "npm run build:visual && node scripts/visual/selftest.mjs",
    "verify:a11y": "vite build --mode visual && node scripts/a11y/check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
